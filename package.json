{
  "name": "@lvce-editor/auth-process-monorepo",
  "version": "0.0.0-dev",
  "description": "Auth Process Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/auth-process.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:watch": "./node_modules/.bin/esbuild --format=esm --platform=node --bundle --external:electron --external:trash --external:ws --watch packages/auth-process/src/authProcessMain.ts --outfile=packages/auth-process/dist/index.js",
    "dev": "node packages/build/src/dev.ts",
    "format": "prettier --write .",
    "lint": "eslint . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 130
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.16.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "knip": "^6.44.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
